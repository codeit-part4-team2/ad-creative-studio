OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MODEL_SERVER_URL=http://localhost:8001
API_BASE_URL=http://localhost:8000
# web/(Next.js)이 브라우저에서 직접 이 서버를 호출하므로 CORS 허용 origin이 필요하다.
# 쉼표로 여러 개 지정 가능, 배포 시 실제 도메인으로 바꿀 것.
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
LOG_LEVEL=INFO

OPENAI_WARNING_THRESHOLD_USD=20
OPENAI_BUDGET_LIMIT_USD=25

MAX_TIME_SLOTS_PER_REQUEST=3

# false로 바꾸면 실제 model_server(R3) 사용, 기본은 true(Mock) - R3 완성 전까지 true 유지
USE_MOCK_GENERATION=true
# false로 바꾸면 실제 쇼츠 생성 서비스(담당자 generate_rush_hour_short) 사용, 기본은 true(Mock)
USE_MOCK_VIDEO=true
# 쇼츠 담당자의 실제 서비스 연동 시 사용 (RushHourVideoGenerationService 구현 시 채울 예정)
SHORTS_SERVICE_URL=
# true면 OpenAI로 실제 문구 생성 시도(실패 시 규칙 기반 폴백), 기본은 false(규칙 기반)
USE_LLM_COPY=false
