OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MODEL_SERVER_URL=http://localhost:8001
API_BASE_URL=http://localhost:8000
# model_server가 상품 이미지를 다시 내려받을 수 있는 backend 주소
BACKEND_PUBLIC_URL=http://localhost:8000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
MODEL_OUTPUT_DIR=data/outputs
LOG_LEVEL=INFO

OPENAI_WARNING_THRESHOLD_USD=20
OPENAI_BUDGET_LIMIT_USD=25

MAX_TIME_SLOTS_PER_REQUEST=3

# false로 바꾸면 실제 model_server(R3) 사용, 기본은 true(Mock) - R3 완성 전까지 true 유지
USE_MOCK_GENERATION=true
# false로 바꾸면 실제 쇼츠 생성 서비스(담당자 generate_rush_hour_short) 사용, 기본은 true(Mock)
USE_MOCK_VIDEO=true
# true면 OpenAI로 실제 문구 생성 시도(실패 시 규칙 기반 폴백), 기본은 false(규칙 기반)
USE_LLM_COPY=false

# model_server: 기본은 빠른 배경 생성 + 원본 상품 합성
MODEL_PROFILE=fast_composite
IMAGE_SIZE=1024
FAST_NUM_INFERENCE_STEPS=4
FAST_GUIDANCE_SCALE=1.0
QUALITY_NUM_INFERENCE_STEPS=30
QUALITY_GUIDANCE_SCALE=7.5
CONTROLNET_CONDITIONING_SCALE=0.6
IP_ADAPTER_SCALE=0.3
PRODUCT_FILL_RATIO=0.5
PRODUCT_CACHE_MAX_ENTRIES=16
PRODUCT_CACHE_TTL_SECONDS=3600
ENABLE_TORCH_COMPILE=false
# GPU 없는 장비에서 대형 모델을 실수로 내려받고 실행하는 일을 막음
ALLOW_CPU_INFERENCE=false
