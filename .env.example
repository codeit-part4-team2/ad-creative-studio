OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
MODEL_SERVER_URL=http://localhost:8001
API_BASE_URL=http://localhost:8000
# web/(Next.js)이 브라우저에서 직접 이 서버를 호출하므로 CORS 허용 origin이 필요하다.
# 쉼표로 여러 개 지정 가능, 배포 시 실제 도메인으로 바꿀 것.
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
LOG_LEVEL=INFO

OPENAI_WARNING_THRESHOLD_USD=20
OPENAI_BUDGET_LIMIT_USD=25

MAX_TIME_SLOTS_PER_REQUEST=3

# false로 바꾸면 실제 model_server(R3) 사용, 기본은 true(Mock) - R3 완성 전까지 true 유지
USE_MOCK_GENERATION=true
# true면 OpenAI로 실제 문구 생성 시도(실패 시 규칙 기반 폴백), 기본은 false(규칙 기반)
USE_LLM_COPY=false

# model_server: 기본은 빠른 배경 생성 + 원본 상품 합성
MODEL_PROFILE=fast_composite
# fast_composite의 SDXL 배경 생성 크기. 최종 출력 IMAGE_SIZE와 제품 캔버스는 1024 유지
FAST_BACKGROUND_SIZE=768
IMAGE_SIZE=1024
FAST_NUM_INFERENCE_STEPS=4
FAST_GUIDANCE_SCALE=1.0
QUALITY_NUM_INFERENCE_STEPS=30
QUALITY_GUIDANCE_SCALE=7.5
CONTROLNET_CONDITIONING_SCALE=0.6
IP_ADAPTER_SCALE=0.3
PRODUCT_FILL_RATIO=0.5
PRODUCT_CACHE_MAX_ENTRIES=16
PRODUCT_CACHE_TTL_SECONDS=3600
ENABLE_TORCH_COMPILE=false
# GPU 없는 장비에서 대형 모델을 실수로 내려받고 실행하는 일을 막음
ALLOW_CPU_INFERENCE=false

# 9:16 쇼츠 렌더링 (1080x1920, H.264/AAC)
VIDEO_DIR=data/videos
VIDEO_WORK_DIR=var/video-work
VIDEO_FONT_PATH=assets/fonts/NanumGothic-Regular.ttf
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_FFMPEG_PRESET=veryfast

# MeloTTS는 실행 중 다운로드하지 않습니다. 고정 리비전 소스와 검증된 모델의 절대 경로를 지정하세요.
MELOTTS_SOURCE_DIR=
MELOTTS_CONFIG_PATH=
MELOTTS_CHECKPOINT_PATH=

# OAuth 파일은 반드시 이 저장소 밖의 운영자 전용 경로를 사용
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=
YOUTUBE_CONNECTION_ID=demo_merchant_channel
YOUTUBE_UPLOAD_ENABLED=false

# 관리자가 고객사(customer_id+PIN) 생성 시 사용하는 보호 키 - 설정 안 하면 admin
# endpoint가 기본적으로 막힌다(열어두는 쪽으로 fail하지 않음). 절대 커밋 금지.
ADMIN_API_KEY=