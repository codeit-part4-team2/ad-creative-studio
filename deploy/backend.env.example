# Copy outside the repository, replace every REPLACE_* value with an absolute VM path,
# and chmod 600 before attaching it to systemd.
MODEL_SERVER_URL=http://127.0.0.1:8001
VIDEO_DIR=REPLACE_REPO_ROOT/data/videos
VIDEO_WORK_DIR=REPLACE_RUNTIME_ROOT/video-work
VIDEO_FONT_PATH=REPLACE_REPO_ROOT/assets/fonts/NanumGothic-Regular.ttf
VIDEO_FAILED_WORK_TTL_SECONDS=604800
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_FFMPEG_PRESET=veryfast

MELOTTS_SOURCE_DIR=REPLACE_RUNTIME_ROOT/src/MeloTTS
MELOTTS_CONFIG_PATH=REPLACE_RUNTIME_ROOT/models/melotts-korean/config.json
MELOTTS_CHECKPOINT_PATH=REPLACE_RUNTIME_ROOT/models/melotts-korean/checkpoint.pth

YOUTUBE_CONNECTION_ID=demo_merchant_channel
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=
